{
    "name": "dorsetdigital/silverstripe-schema-manager",
    "description": "Structured data schema registry and helpers for Silverstripe CMS 5 and 6.",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Dorset Digital",
            "homepage": "https://github.com/DorsetDigital"
        }
    ],
    "keywords": [
        "silverstripe",
        "schema.org",
        "json-ld",
        "structured-data",
        "seo"
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5 || ^6",
        "silverstripe/cms": "^5 || ^6",
        "silverstripe/siteconfig": "^5 || ^6",
        "silverstripe/assets": "^2 || ^3",
        "silverstripe/asset-admin": "^2 || ^3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10 || ^11.3",
        "silverstripe/recipe-testing": "^3 || ^4"
    },
    "suggest": {
        "silverstripe/blog": "Enable the optional BlogPosting schema extension for Silverstripe Blog posts."
    },
    "autoload": {
        "psr-4": {
            "DorsetDigital\\SchemaManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DorsetDigital\\SchemaManager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
